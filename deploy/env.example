# Copy to ~/.config/macmini-watch/env and chmod 600.
# Sourced by the LaunchAgent before each run of check.py.
#
# At least one notification destination (Slack or Telegram) must be set,
# otherwise the script runs in dry-run mode and only logs to stderr.

# --- Slack (optional) ---
SLACK_WEBHOOK_URL=

# Slack user IDs to @-mention on alerts (test pings included).
# Comma-separated for multiple; quote the value if you include spaces
# (env file is sourced by zsh). Leave empty to skip mentions.
SLACK_MENTION_USER_IDS=

# --- Telegram (optional) ---
# Bot token from @BotFather (looks like "123456:ABC-DEF...").
TELEGRAM_BOT_TOKEN=
# Chat ID to send messages to. For a 1:1 chat with your bot, this is your
# personal Telegram user ID (a number). Get it by messaging your bot once,
# then visiting https://api.telegram.org/bot<TOKEN>/getUpdates and reading
# the "chat":{"id":...} field.
TELEGRAM_CHAT_ID=

# --- Price ceiling in USD. Listings at-or-below this fire alerts. ---
PRICE_CAP=600
