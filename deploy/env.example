# Copy to ~/.config/macmini-watch/env and chmod 600.
# Sourced by the LaunchAgent before each run of check.py.
#
# Required: Slack incoming webhook URL.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/PLEASE

# Optional: Slack user IDs to @-mention on real (non-test) hits.
# Comma-separated for multiple. Leave empty to skip mentions.
SLACK_MENTION_USER_IDS=

# Price ceiling in USD. The script reports any matching listing at-or-below this.
PRICE_CAP=600
